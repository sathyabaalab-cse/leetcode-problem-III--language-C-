double findMedianSortedArrays(int* nums1, int nums1Size, int* nums2, int nums2Size) {
    int m = nums1Size;
    int n = nums2Size;
    int totalLength = m + n;
    int targetIndex = totalLength / 2;
    int i = 0; 
    int j = 0;
    int current = 0;  
    int previous = 0; 
    for (int count = 0; count <= targetIndex; count++) {
        previous = current;
        if (i < m && (j >= n || nums1[i] <= nums2[j])) {
            current = nums1[i];
            i++;
        } else {
            current = nums2[j];
            j++;
        }
    }
    if (totalLength % 2 != 0) {
        return (double)current;
    }
    return (current + previous) / 2.0;
}
