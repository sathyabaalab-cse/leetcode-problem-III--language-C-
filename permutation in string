#include <stdbool.h>
#include <string.h>
bool checkInclusion(char* s1, char* s2) {
    int len1 = strlen(s1);
    int len2 = strlen(s2);
    if (len1 > len2) {
        return false;
    }
    int s1_freq[26] = {0};
    int window_freq[26] = {0};
    for (int i = 0; i < len1; i++) {
        s1_freq[s1[i] - 'a']++;
        window_freq[s2[i] - 'a']++;
    }
    if (memcmp(s1_freq, window_freq, sizeof(s1_freq)) == 0) {
        return true;
    }
    for (int i = len1; i < len2; i++) {
        window_freq[s2[i] - 'a']++;
        window_freq[s2[i - len1] - 'a']--;
        if (memcmp(s1_freq, window_freq, sizeof(s1_freq)) == 0) {
            return true;
        }
    }
    
    return false;
}
