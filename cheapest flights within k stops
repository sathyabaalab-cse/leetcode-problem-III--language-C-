#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define INF 1e9

int findCheapestPrice(int n, int** flights, int flightsSize, int* flightsColSize, int src, int dst, int k) {
    // 1. Allocate a distance tracking array
    int* dist = (int*)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        dist[i] = INF;
    }
    dist[src] = 0;

    // A temporary array to prevent using updated distances from the current iteration
    int* tempDist = (int*)malloc(n * sizeof(int));

    // 2. Relax edges at most K + 1 times (K stops allows K + 1 flights)
    for (int i = 0; i <= k; i++) {
        // Copy current best distances to temp array
        memcpy(tempDist, dist, n * sizeof(int));

        // Iterate through all available flights
        for (int j = 0; j < flightsSize; j++) {
            int u = flights[j][0];
            int v = flights[j][1];
            int price = flights[j][2];

            // If node u has been reached in a previous round, try relaxing edge u -> v
            if (dist[u] != INF && dist[u] + price < tempDist[v]) {
                tempDist[v] = dist[u] + price;
            }
        }
        
        // Update main distance array with values computed in this layer iteration
        memcpy(dist, tempDist, n * sizeof(int));
    }

    int result = dist[dst];

    // 3. Memory Cleanup
    free(dist);
    free(tempDist);

    // If destination remains untouched, it is unreachable within K stops
    return (result == INF) ? -1 : result;
}
