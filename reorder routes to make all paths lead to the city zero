#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>

// Structure to represent an edge in the adjacency list
typedef struct Edge {
    int to;
    int isOriginal; // 1 if it's the original direction (away from root), 0 if reversed
    struct Edge* next;
} Edge;

// Function to add an edge to the adjacency list
void addEdge(Edge** adj, int from, int to, int isOriginal) {
    Edge* newEdge = (Edge*)malloc(sizeof(Edge));
    newEdge->to = to;
    newEdge->isOriginal = isOriginal;
    newEdge->next = adj[from];
    adj[from] = newEdge;
}

int minReorder(int n, int** connections, int connectionsSize, int* connectionsColSize) {
    // 1. Allocate and initialize the adjacency list
    Edge** adj = (Edge**)calloc(n, sizeof(Edge*));
    for (int i = 0; i < connectionsSize; i++) {
        int u = connections[i][0];
        int v = connections[i][1];
        // Original road points from u to v (if traveling from root 0, this is pointing away)
        addEdge(adj, u, v, 1);
        // Fake road points from v to u (if traveling from root 0, this is pointing toward root)
        addEdge(adj, v, u, 0);
    }

    // 2. BFS configuration
    bool* visited = (bool*)calloc(n, sizeof(bool));
    int* queue = (int*)malloc(n * sizeof(int));
    int head = 0, tail = 0;
    int reorderCount = 0;

    // Start BFS from the capital (city 0)
    queue[tail++] = 0;
    visited[0] = true;

    // 3. BFS Traversal
    while (head < tail) {
        int curr = queue[head++];

        Edge* edge = adj[curr];
        while (edge != NULL) {
            int neighbor = edge->to;
            
            if (!visited[neighbor]) {
                visited[neighbor] = true;
                
                // If the original road points from parent (curr) to child (neighbor),
                // it points away from the capital. We must flip it.
                if (edge->isOriginal == 1) {
                    reorderCount++;
                }
                
                queue[tail++] = neighbor;
            }
            edge = edge->next;
        }
    }

    // 4. Memory Cleanup
    for (int i = 0; i < n; i++) {
        Edge* edge = adj[i];
        while (edge != NULL) {
            Edge* temp = edge;
            edge = edge->next;
            free(temp);
        }
    }
    free(adj);
    free(visited);
    free(queue);

    return reorderCount;
}
