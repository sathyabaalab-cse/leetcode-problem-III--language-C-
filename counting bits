#include <stdlib.h>
int* countBits(int n, int* returnSize) {
    *returnSize = n + 1; 
    int* ans = (int*)malloc((n + 1) * sizeof(int));
    ans[0] = 0;
    for (int i = 1; i <= n; i++) {
        int half_number = i / 2;
        int is_odd = i % 2;
        ans[i] = ans[half_number] + is_odd;
    }
    return ans;
}
